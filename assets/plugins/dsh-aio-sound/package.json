{
  "name": "dsh-aio-sound",
  "version": "1.1.0",
  "private": true,
  "description": "DSHEAC AIO 配套插件：为顶层会话完成、手动中断、询问和最终错误分别配置提示音。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.0.1",
    "node": ">=20.0.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "assets"
  ],
  "license": "MIT"
}
